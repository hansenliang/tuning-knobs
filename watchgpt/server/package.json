{
  "name": "watchgpt-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "WatchGPT gateway: device auth, quotas, turn (NDJSON) and live (WebSocket) voice APIs over pluggable STT/LLM/TTS/realtime providers.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.0"
  }
}
